---
import { Image } from 'astro:assets';
import herramientas from '../assets/herramientas.jpg';
import type { ImageMetadata } from 'astro';
import { negocio, horario, barberos } from '../data/negocio';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/barberos/*.{jpg,jpeg,png,webp}', { eager: true });
const fotoDe = (nombre: string) =>
  Object.entries(fotos).find(([ruta]) => ruta.split('/').pop()!.replace(/\.\w+$/, '') === nombre)?.[1].default;
---

<section id="contacto" class="section alt">
  <div class="container grid">
    <div class="info">
      <p class="eyebrow">Visítanos</p>
      <h2 class="section-title">Dónde estamos</h2>
      <dl>
        <div>
          <dt>Dirección</dt>
          <dd>
            <a href={negocio.mapsUrl} target="_blank" rel="noopener">
              {negocio.direccion}<br />{negocio.cp} {negocio.ciudad}, {negocio.provincia}
            </a>
          </dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd><a href={negocio.telefonoHref}>{negocio.telefono}</a></dd>
        </div>
        <!-- <div>
          <dt>Horario</dt>
          <dd>
            <table>
              <tbody>
                {
                  horario.map((h) => (
                    <tr>
                      <th scope="row">{h.dias}</th>
                      <td>{h.horas}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </dd>
        </div> -->
        <div>
          <dt>Barberos</dt>
          <dd>
            <ul class="barberos">
              {
                barberos.map((b) => {
                  const foto = fotoDe(b.foto);
                  return (
                    <li class="barbero">
                      {foto ? (
                        <Image src={foto} alt={`Foto de ${b.nombre}`} class="avatar" width={128} height={128} />
                      ) : (
                        <span class="avatar iniciales" aria-hidden="true">{b.nombre.charAt(0)}</span>
                      )}
                      <div>
                        <p class="nombre">{b.nombre}</p>
                        <table>
                          <tbody>
                            {b.horario.map((h) => (
                              <tr>
                                <th scope="row">{h.dias}</th>
                                <td>{h.horas.map((t, i) => (<>{i > 0 && <br />}{t}</>))}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </li>
                  );
                })
              }
            </ul>
          </dd>
        </div>
      </dl>
      <div class="actions">
        <a class="btn btn-primary" href={negocio.booksyUrl} target="_blank" rel="noopener">Reservar en Booksy</a>
        <a class="btn btn-ghost" href={negocio.mapsUrl} target="_blank" rel="noopener">Cómo llegar</a>
      </div>
    </div>
    <div class="media">
      <iframe
        title={`Mapa de ${negocio.nombre}`}
        src={negocio.mapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <Image src={herramientas} alt="Sala de Luisferbarberia" class="tools" widths={[400, 700]} sizes="(max-width: 900px) 100vw, 40vw" />
    </div>
  </div>
</section>

<style>
  .alt {
    background: var(--bg-2);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  dl {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0;
  }
  dt {
    color: var(--gold);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  dd {
    margin: 0;
    font-size: 1.05rem;
  }
  dd a {
    text-decoration: none;
  }
  dd a:hover {
    color: var(--gold);
  }
  table {
    border-collapse: collapse;
  }
  th {
    text-align: left;
    font-weight: 400;
    color: var(--muted);
    padding: 0.15rem 1.5rem 0.15rem 0;
  }
  .barberos {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .barbero {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.02);
  }
  .avatar {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--gold);
  }
  .iniciales {
    display: grid;
    place-items: center;
    background: var(--gold);
    color: var(--bg);
    font-family: var(--font-title);
    font-size: 1.6rem;
    font-weight: 700;
  }
  .nombre {
    margin: 0 0 0.35rem;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .barbero table {
    font-size: 0.9rem;
  }
  .barbero th,
  .barbero td {
    vertical-align: top;
    white-space: nowrap;
  }
  .barbero th {
    padding-right: 1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .media {
    display: grid;
    gap: 1rem;
  }
  iframe {
    width: 100%;
    height: 320px;
    border: 0;
    border-radius: var(--radius);
    filter: grayscale(1) invert(0.9) contrast(0.9);
  }
  .tools {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
