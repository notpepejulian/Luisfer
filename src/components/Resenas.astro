---
import { resenas, negocio } from '../data/negocio';
import { getValoraciones, formatoNota } from '../lib/valoraciones';
import { haceCuanto } from '../lib/tiempo';
import Contador from './Contador.astro';

const v = await getValoraciones();
const plataformas = [
  { nombre: 'Google', datos: v.google, url: negocio.mapsUrl },
  { nombre: 'Booksy', datos: v.booksy, url: negocio.booksyUrl },
];
---

<section id="resenas" class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Opiniones de clientes</p>
      <h2 class="section-title">Lo que dicen nuestros clientes</h2>
    </div>
    <div class="plataformas">
      {
        plataformas.map((p) => (
          <a class="plataforma" href={p.url} target="_blank" rel="noopener">
            <span class="nota">{formatoNota(p.datos.nota)}</span>
            <div>
              <span class="stars" aria-label={`${formatoNota(p.datos.nota)} de 5 estrellas`}>
                ★★★★★
              </span>
              <p>
                <Contador valor={p.datos.total} /> reseñas en <strong>{p.nombre}</strong>
              </p>
            </div>
          </a>
        ))
      }
    </div>
    <ul class="grid">
      {
        resenas.map((r) => (
          <li class="card">
            <span class="stars" aria-label={`${r.estrellas} de 5 estrellas`}>{'★'.repeat(r.estrellas)}</span>
            <blockquote>“{r.texto}”</blockquote>
            <div class="autor">
              <span class="avatar" aria-hidden="true">{r.autor.charAt(0).toUpperCase()}</span>
              <div>
                <strong>{r.autor}</strong>
                <small>
                  <time datetime={r.fecha} data-relativo>{haceCuanto(r.fecha)}</time> · {r.fuente}
                </small>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="center">
      <a class="btn btn-ghost" href={negocio.mapsUrl} target="_blank" rel="noopener">Ver reseñas en Google</a>
      <a class="btn btn-ghost" href={negocio.booksyUrl} target="_blank" rel="noopener">Ver reseñas en Booksy</a>
    </div>
  </div>
</section>

<script>
  import { haceCuanto } from '../lib/tiempo';
  document.querySelectorAll<HTMLTimeElement>('time[data-relativo]').forEach((t) => {
    t.textContent = haceCuanto(t.dateTime);
  });
</script>

<style>
  .plataformas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin: -1rem 0 3rem;
  }
  .plataforma {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .plataforma:hover {
    border-color: var(--gold);
  }
  .nota {
    font-family: var(--font-title);
    font-size: 3rem;
    line-height: 1;
    color: var(--gold);
  }
  .plataforma .stars {
    font-size: 1.2rem;
  }
  .plataforma p {
    margin: 0;
    color: var(--muted);
  }
  .plataforma strong {
    color: var(--text);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  blockquote {
    margin: 0.75rem 0 1.5rem;
    flex: 1;
  }
  .autor {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--gold);
    color: #111;
    font-weight: 600;
  }
  .autor small {
    display: block;
    color: var(--muted);
  }
  .center {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
  }
</style>
