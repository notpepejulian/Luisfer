---
import { resenas, negocio } from '../data/negocio';
const nota = negocio.valoracion.toFixed(1).replace('.', ',');
---

<section id="resenas" class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Opiniones en Google</p>
      <h2 class="section-title">Lo que dicen nuestros clientes</h2>
      <div class="summary">
        <span class="nota">{nota}</span>
        <div>
          <span class="stars" aria-label={`${nota} de 5 estrellas`}>★★★★★</span>
          <p>{negocio.totalResenas} reseñas en Google</p>
        </div>
      </div>
    </div>
    <ul class="grid">
      {
        resenas.map((r) => (
          <li class="card">
            <span class="stars" aria-label={`${r.estrellas} de 5 estrellas`}>{'★'.repeat(r.estrellas)}</span>
            <blockquote>“{r.texto}”</blockquote>
            <div class="autor">
              <span class="avatar" aria-hidden="true">{r.autor.charAt(0).toUpperCase()}</span>
              <div>
                <strong>{r.autor}</strong>
                <small>{r.fecha} · Google</small>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="center">
      <a class="btn btn-ghost" href={negocio.mapsUrl} target="_blank" rel="noopener">Ver todas las reseñas en Google</a>
    </div>
  </div>
</section>

<style>
  .summary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    text-align: left;
  }
  .nota {
    font-family: var(--font-title);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--gold);
  }
  .summary .stars {
    font-size: 1.3rem;
  }
  .summary p {
    margin: 0;
    color: var(--muted);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  blockquote {
    margin: 0.75rem 0 1.5rem;
    flex: 1;
  }
  .autor {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--gold);
    color: #111;
    font-weight: 600;
  }
  .autor small {
    display: block;
    color: var(--muted);
  }
  .center {
    text-align: center;
    margin-top: 3rem;
  }
</style>
