---
import { categoriasServicios, negocio } from '../data/negocio';
const precio = (n: number) => n.toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });
---

<section id="servicios" class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Servicios</p>
      <h2 class="section-title">Precios</h2>
      <p>Elige tu servicio y agenda tu cita en Booksy.</p>
    </div>
    {
      categoriasServicios.map((c) => (
        <div class:list={['categoria', { destacada: c.destacada }]}>
          <h3 class="cat-titulo">
            {c.nombre}
            {!c.destacada && <small>{c.servicios.length} servicios</small>}
          </h3>
          <ul class="grid">
            {c.servicios.map((s) => (
              <li class="card">
                <div class="info">
                  <h4>{s.nombre}</h4>
                  <span class="duracion">{s.duracion} min</span>
                </div>
                <span class="precio">{precio(s.precio)}</span>
                <a class="btn btn-primary agendar" href={negocio.booksyUrl} target="_blank" rel="noopener">
                  Agendar
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .categoria + .categoria {
    margin-top: 3rem;
  }
  .cat-titulo {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.4rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .cat-titulo small {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0;
  }
  .destacada .cat-titulo {
    color: var(--gold);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: rgba(201, 164, 92, 0.5);
  }
  .destacada .card {
    border-color: rgba(201, 164, 92, 0.45);
  }
  .info {
    flex: 1;
  }
  h4 {
    margin: 0 0 0.35rem;
    font-family: var(--font-title);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.15rem;
    font-weight: 500;
  }
  .duracion {
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--bg-3);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .precio {
    font-family: var(--font-title);
    font-size: 1.35rem;
    color: var(--gold);
    white-space: nowrap;
  }
  .agendar {
    padding: 0.55rem 1.1rem;
    font-size: 0.9rem;
  }
</style>
